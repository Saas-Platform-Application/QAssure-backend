		{
			"name": "Setup — SSO Launch Flow",
			"item": [
				{
					"name": "Step 1 — Login (get user JWT)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 200', function() {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"var jsonData = pm.response.json();",
									"",
									"pm.test('Has token in response', function() {",
									"    pm.expect(jsonData.data).to.have.property('token');",
									"    pm.expect(jsonData.data.token).to.be.a('string');",
									"});",
									"",
									"pm.test('Has user details with department', function() {",
									"    pm.expect(jsonData.data.user).to.have.property('email');",
									"    if (jsonData.data.user.department) {",
									"        pm.expect(jsonData.data.user.department).to.be.a('string');",
									"    }",
									"    if (jsonData.data.user.designation) {",
									"        pm.expect(jsonData.data.user.designation).to.be.a('string');",
									"    }",
									"    if (jsonData.data.user.user_category) {",
									"        pm.expect(jsonData.data.user.user_category).to.be.a('string');",
									"    }",
									"});",
									"",
									"// Capture tenant_token for Step 2",
									"pm.collectionVariables.set('tenant_token', jsonData.data.token);",
									"console.log('✅ tenant_token captured');"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "// {\n//   \"email\": \"polumuri.suresh@ltts.com\",\n//   \"password\": \"Password123!\"\n// }\n{\n  \"email\": \"tenant8admin@gmail.com\",\n  \"password\": \"Password123!\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"login"
							]
						},
						"description": "Login as tenant admin to get user JWT.\nCaptures: tenant_token\n\nCredentials: tenantadmin@pharmacorp.com / SecurePass123!"
					},
					"response": []
				},
				{
					"name": "Step 2 — Launch Module (get launch token)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 200', function() {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"var jsonData = pm.response.json();",
									"",
									"pm.test('Has launch_url', function() {",
									"    pm.expect(jsonData.data).to.have.property('launch_url');",
									"    pm.expect(jsonData.data.launch_url).to.include('token=');",
									"});",
									"",
									"// Extract launch_token from launch_url query parameter",
									"var launchUrl = jsonData.data.launch_url;",
									"var launchToken = launchUrl.split('token=')[1];",
									"if (launchToken && launchToken.indexOf('&') > -1) {",
									"    launchToken = launchToken.split('&')[0];",
									"}",
									"",
									"pm.collectionVariables.set('launch_token', launchToken);",
									"console.log('✅ launch_token captured: ' + launchToken.substring(0, 20) + '...');"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{tenant_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/modules/{{coc_module_id}}/launch",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"modules",
								"{{coc_module_id}}",
								"launch"
							]
						},
						"description": "Launch the CoC module to get a launch token.\nUses tenant_token from Step 1.\nCaptures: launch_token (extracted from launch_url query param)"
					},
					"response": []
				},
				{
					"name": "Step 3 — Verify Launch Token (get module JWT)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 200', function() {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"var jsonData = pm.response.json();",
									"",
									"pm.test('Has module session token', function() {",
									"    pm.expect(jsonData.data).to.have.property('token');",
									"    pm.expect(jsonData.data.token).to.be.a('string');",
									"});",
									"",
									"pm.test('Has user details with department info', function() {",
									"    if (jsonData.data.user) {",
									"        pm.expect(jsonData.data.user).to.have.property('email');",
									"        // Verify department, designation, user_category fields present",
									"        if (jsonData.data.user.department !== undefined) {",
									"            console.log('User department: ' + jsonData.data.user.department);",
									"        }",
									"        if (jsonData.data.user.designation !== undefined) {",
									"            console.log('User designation: ' + jsonData.data.user.designation);",
									"        }",
									"        if (jsonData.data.user.user_category !== undefined) {",
									"            console.log('User category: ' + jsonData.data.user.user_category);",
									"        }",
									"    }",
									"});",
									"",
									"pm.test('Has tenant details', function() {",
									"    if (jsonData.data.tenant) {",
									"        pm.expect(jsonData.data.tenant).to.have.property('id');",
									"    }",
									"});",
									"",
									"pm.test('Has permissions', function() {",
									"    if (jsonData.data.permissions) {",
									"        pm.expect(jsonData.data.permissions).to.be.an('array');",
									"    }",
									"});",
									"",
									"// Capture module_jwt for all subsequent Combined Auth requests",
									"pm.collectionVariables.set('module_jwt', jsonData.data.token);",
									"console.log('✅ module_jwt captured — Combined Auth ready');"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "X-API-Key",
								"value": "{{api_key}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"token\": \"{{launch_token}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/modules/verify-launch-token",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"modules",
								"verify-launch-token"
							]
						},
						"description": "Verify launch token to get module session JWT (24h expiry).\nUses X-API-Key (NOT Bearer token).\nCaptures: module_jwt\n\nResponse includes: token, user details (with department, designation, user_category), tenant details, permissions.\n\nAfter this step, use Combined Auth on all requests:\n- Authorization: Bearer {{module_jwt}}\n- X-API-Key: {{api_key}}"
					},
					"response": []
				},
				{
					"name": "Use JWT + X-Api-Key",
					"protocolProfileBehavior": {
						"disableBodyPruning": true
					},
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{module_jwt}}",
								"type": "text"
							},
							{
								"key": "X-API-Key",
								"value": "{{api_key}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/ai/providers",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"ai",
								"providers"
							]
						}
					},
					"response": []
				}
			],
			"description": "Three-step SSO flow to establish Combined Auth (JWT + API Key).\nRun these sequentially before any other requests.\n\nFlow: Login → Launch Module → Verify Launch Token → Combined Auth ready"
		},
