				{
					"name": "2.2 Launch Module (Generate SSO Token)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"",
									"pm.test('Launch successful', function() {",
									"    pm.expect(jsonData.success).to.be.true;",
									"});",
									"",
									"pm.test('Returns launch URL with token', function() {",
									"    pm.expect(jsonData.data.launch_url).to.exist;",
									"    pm.expect(jsonData.data.launch_url).to.include('token=mlt_');",
									"});",
									"",
									"pm.test('Token expires in 60 seconds', function() {",
									"    pm.expect(jsonData.data.expires_in).to.equal(60);",
									"});",
									"",
									"if (jsonData.success && jsonData.data.launch_url) {",
									"    // Extract token from URL",
									"    var url = jsonData.data.launch_url;",
									"    var token = url.split('token=')[1];",
									"    pm.collectionVariables.set('launch_token', token);",
									"    console.log('✅ Launch token saved:', token.substring(0, 20) + '...');",
									"    console.log('🔗 Launch URL:', url);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": ""
						},
						"url": {
							"raw": "{{base_url}}/modules/{{module_id}}/launch",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"modules",
								"{{module_id}}",
								"launch"
							]
						},
						"description": "Generate a one-time SSO launch token for a module.\n\n**Token Properties:**\n- Valid for 60 seconds only\n- Single-use (cannot be reused)\n- Bound to specific module\n- Contains user context (snapshotted at launch time)\n\n**Response:**\n- `launch_url`: Full URL to redirect user to (includes token)\n- `expires_in`: Token validity in seconds (60)\n- `module`: Module info\n- `tenant`: Tenant info\n\n**Flow:**\n1. Frontend receives launch_url\n2. Frontend opens launch_url in browser/new tab\n3. Module receives token and verifies it\n4. Module creates session for user"
					},
