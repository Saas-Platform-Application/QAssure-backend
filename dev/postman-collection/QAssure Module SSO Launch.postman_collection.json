			"name": "3. Module Token Verification (FOR LTTS DEVELOPERS)",
			"item": [
				{
					"name": "3.1 Verify Launch Token ⭐ MAIN ENDPOINT",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"",
									"if (jsonData.success) {",
									"    pm.test('Verification successful', function() {",
									"        pm.expect(jsonData.success).to.be.true;",
									"    });",
									"    ",
									"    pm.test('User info returned', function() {",
									"        pm.expect(jsonData.data.user).to.exist;",
									"        pm.expect(jsonData.data.user.id).to.exist;",
									"        pm.expect(jsonData.data.user.email).to.exist;",
									"    });",
									"    ",
									"    pm.test('Tenant info returned', function() {",
									"        pm.expect(jsonData.data.tenant).to.exist;",
									"        pm.expect(jsonData.data.tenant.id).to.exist;",
									"        pm.expect(jsonData.data.tenant.name).to.exist;",
									"    });",
									"    ",
									"    pm.test('Access flags returned', function() {",
									"        pm.expect(jsonData.data.access).to.exist;",
									"        pm.expect(jsonData.data.access.is_super_admin).to.be.a('boolean');",
									"        pm.expect(jsonData.data.access.is_tenant_admin).to.be.a('boolean');",
									"    });",
									"    ",
									"    console.log('✅ User:', jsonData.data.user.email);",
									"    console.log('✅ Tenant:', jsonData.data.tenant.name);",
									"    console.log('✅ Is Admin:', jsonData.data.access.is_tenant_admin);",
									"} else {",
									"    console.log('❌ Error:', jsonData.error.message);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
