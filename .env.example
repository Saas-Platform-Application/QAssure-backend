# ===========================================
# QASSURE.AI PLATFORM CONFIGURATION v3.0
# ===========================================

# ─────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
PLATFORM_NAME=QAssure.ai
PLATFORM_VERSION=1.0.0
BASE_URL=http://localhost:3000
APP_URL=http://localhost:5173

# ─────────────────────────────────────────
# DATABASE (PostgreSQL)
# ─────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres123@localhost:5434/qassure_dev
DB_HOST=localhost
DB_PORT=5434
DB_NAME=qassure_dev
DB_USER=postgres
DB_PASSWORD=postgres123
DB_SSL=false
DB_POOL_MIN=5
DB_POOL_MAX=20

# ─────────────────────────────────────────
# REDIS
# ─────────────────────────────────────────
REDIS_URL=redis://localhost:6380
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=qassure:
REDIS_CLUSTER_MODE=false

# ─────────────────────────────────────────
# KAFKA
# ─────────────────────────────────────────
KAFKA_BROKERS=localhost:29092
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_CLIENT_ID=qassure-platform
KAFKA_GROUP_ID=qassure-consumer-group
KAFKA_SSL=false

# ─────────────────────────────────────────
# JWT AUTHENTICATION
# ─────────────────────────────────────────
JWT_SECRET=qassure-super-secret-jwt-key-minimum-32-characters
JWT_REFRESH_SECRET=qassure-refresh-token-secret-minimum-32-characters
JWT_ACCESS_EXPIRY=24h
JWT_REFRESH_EXPIRY=7d
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=qassure.ai
JWT_AUDIENCE=qassure-platform

# ─────────────────────────────────────────
# IDLE SESSION / AUTO-LOGOUT
# ─────────────────────────────────────────
# Total idle time (in minutes) before session is force-expired at refresh time
IDLE_TIMEOUT_MINUTES=30
# Enable or disable idle timeout enforcement (set to false to bypass in dev/testing)
IDLE_TIMEOUT_ENABLED=true

# ─────────────────────────────────────────
# MFA CONFIGURATION
# ─────────────────────────────────────────
MFA_ENABLED=true
MFA_ISSUER=QAssure.ai
MFA_TOTP_WINDOW=1

# ─────────────────────────────────────────
# AI/LLM CONFIGURATION (Direct Providers)
# ─────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# ─────────────────────────────────────────
# AZURE AI CONFIGURATION
# ─────────────────────────────────────────
# Azure OpenAI (OpenAIProvider)
AZURE_OPENAI_ENDPOINT=https://qassure-aisub-prj-resource.cognitiveservices.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Azure AI Foundry (AnthropicProvider)
AZURE_ANTHROPIC_ENDPOINT=https://qassure-aisub-prj-resource.services.ai.azure.com/anthropic/
AZURE_AI_API_KEY=
AZURE_ANTHROPIC_DEPLOYMENT=claude-sonnet-4-5

AI_DEFAULT_PROVIDER=openai
AI_DEFAULT_MODEL=gpt-4-turbo-preview
AI_FALLBACK_ENABLED=true

# ─────────────────────────────────────────
# ENCRYPTION & SECURITY (CRITICAL)
# ─────────────────────────────────────────
# Must be exactly 32 hex characters (64 characters total)
ENCRYPTION_KEY=e4a887e0e65ff2c2f928bba42cacae3be8cb92ef1d4bbdfb0503ef064e5a49ef
ENCRYPTION_ALGORITHM=aes-256-gcm

# ─────────────────────────────────────────
# INFRASTRUCTURE SERVICES
# ─────────────────────────────────────────
ELASTICSEARCH_NODE=http://localhost:9200
PINECONE_API_KEY=
PINECONE_INDEX_NAME=qassure-knowledge
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@qassure.ai

# ─────────────────────────────────────────
# FILE STORAGE
# ─────────────────────────────────────────
FILE_STORAGE_PATH=./uploads
FILE_MAX_SIZE_MB=50
FILE_ALLOWED_TYPES=pdf,doc,docx,xls,xlsx,png,jpg,jpeg,gif,csv,json

# ─────────────────────────────────────────
# RATE LIMITING & LOGGING
# ─────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
LOG_LEVEL=debug
LOG_FORMAT=json
LOG_REQUESTS=true

# ─────────────────────────────────────────
# CORS
# ─────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173,https://qasure.tech4bizsolutions.com,https://coc-frontend.loca.lt,http://localhost:5174,http://localhost:4173
CORS_CREDENTIALS=true

# ─────────────────────────────────────────
# DEBUG TOOLS
# ─────────────────────────────────────────
PGADMIN_EMAIL=admin@qassure.ai
PGADMIN_PASSWORD=admin123

# ============================================
# LTTS Multi-Model RAG Pipeline (Requirement 3)
# ============================================
# YOLO: document layout detection (regions: text/table/figure)
# LTTS_YOLO_ENDPOINT=https://ltts-yolo.example.com/predict
# LTTS_YOLO_API_KEY=

# LLaVA, DistilBERT, Mistral, Qwen are registered per-tenant via POST /ai/config
# (they speak OpenAI-compatible APIs and use tenant_ai_configs, not env vars)
