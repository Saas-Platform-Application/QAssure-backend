{
	"info": {
		"_postman_id": "caca0f90-ef31-482d-88bb-cfda4091abcf",
		"name": "QAssure — QMS Service",
		"description": "API collection for QAssure QMS Connection and Sync Service.\n\nBase URL: http://localhost:3000/api/v1\n\nAuth: Bearer JWT Token\n\nFolders included:\n- Auth: Helper login endpoints to save the jwt_token\n- Lookups: Static reference data for supported EQMS adapters\n- Connections CRUD: Create, list, get, update, delete QMS connections\n- Entity Mappings CRUD: Create, list, get, update, delete field transformations\n- Sync Jobs CRUD: Create, list, get, update, delete sync job states\n- Sync Conflicts CRUD: Create, list, get, update, delete sync conflict events\n- Connections Operations: Connectivity tests, schemas, active configs\n- Sync Operations: Triggering background sync jobs, status, cancel, and resolve conflicts",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "🔐 Auth",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.access_token) {",
									"    pm.collectionVariables.set('jwt_token', jsonData.data.access_token);",
									"    console.log('✅ Token saved');",
									"}",
									"pm.test('Login successful', function () {",
									"    pm.response.to.have.status(200);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@pharmacorp.com\",\n    \"password\": \"Admin@123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"login"
							]
						},
						"description": "Authenticate user credentials to retrieve JWT token and auto-populate the jwt_token variable."
					},
					"response": []
				}
			]
		},
