		{
			"name": "🔄 CAPA CRUD",
			"item": [
				{
					"name": "1. Create CAPA",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.id) {",
									"    pm.collectionVariables.set('capa_id', jsonData.data.id);",
									"    console.log('✅ CAPA ID saved: ' + jsonData.data.id);",
									"}",
									"pm.test('Created successfully', function () {",
									"    pm.response.to.have.status(201);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"Supplier Raw Material Contamination\",\n    \"description\": \"Impurities identified in raw material batch RM-4902.\",\n    \"capa_type\": \"corrective\",\n    \"source\": \"supplier\",\n    \"priority\": \"high\",\n    \"risk_level\": \"high\",\n    \"problem_statement\": \"Particles discovered inside sealed canisters of RM-4902 during incoming quality control.\",\n    \"immediate_action\": \"Canisters quarantined; vendor notified; hold placed on affected batch.\",\n    \"target_date\": \"2026-09-30\",\n    \"use_8d\": true\n}"
						},
						"url": {
							"raw": "{{base_url}}/capas",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"capas"
							]
						},
						"description": "Create a new CAPA record. Auto-calculates CAPA sequence number and saves UUID into capa_id."
					},
					"response": []
				},
				{
					"name": "2. List CAPAs",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/capas?status=draft&limit=50",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"capas"
							],
							"query": [
								{
									"key": "status",
									"value": "draft"
								},
								{
									"key": "capa_type",
									"value": "corrective",
									"disabled": true
								},
								{
									"key": "priority",
									"value": "high",
									"disabled": true
								},
								{
									"key": "search",
									"value": "Supplier",
									"disabled": true
								},
								{
									"key": "limit",
									"value": "50"
								}
							]
						},
						"description": "Get page list of CAPAs with filters (status, type, priority, source, owner, search term)."
					},
					"response": []
				},
				{
					"name": "3. Get CAPA by ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/capas/{{capa_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"capas",
								"{{capa_id}}"
							]
						},
						"description": "Retrieve full details for a single CAPA including ownership, action items list, and 8D report flag."
					},
					"response": []
				},
				{
					"name": "4. Update CAPA Details",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"problem_statement\": \"Particles discovered inside canisters of RM-4902. Analysis shows steel filings.\",\n    \"root_cause_method\": \"5_why\",\n    \"root_cause\": \"Vibration during transit caused metal scraping on loose canister lids.\",\n    \"containment_action\": \"Lid inspections enforced at vendor loading dock.\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/capas/{{capa_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"capas",
								"{{capa_id}}"
							]
						},
						"description": "Update details (problem statement, root cause method, owner, targets) for a CAPA."
					},
					"response": []
				}
			]
		},
