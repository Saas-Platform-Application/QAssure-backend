							},
							{
								"key": "Authorization",
								"value": "Bearer {{jwt}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"resource_type\": \"document\",\n  \"resource_id\": \"1a2b3c4d-5e6f-7a8b-9c0d-1e2f3a4b5c6d\",\n  \"resource_name\": \"SOP-001 Quality Policy\",\n  \"action\": \"APPROVE\",\n  \"meaning\": \"I approve the release and content of this standard operating procedure.\",\n  \"password\": \"Password123!\",\n  \"pin\": \"1234\",\n  \"auth_method\": \"password_pin\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/electronic-signatures/sign",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"electronic-signatures",
								"sign"
							]
						}
					},
					"response": []
				},
				{
