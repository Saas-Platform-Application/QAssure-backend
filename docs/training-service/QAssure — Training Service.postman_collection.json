          },
          "response": []
        },
        {
          "name": "Complete Training (Pass)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"score\": 92\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/training/assignments/{{assignmentId}}/complete", "host": ["{{baseUrl}}"], "path": ["api","v1","training","assignments","{{assignmentId}}","complete"] }
          },
          "response": []
        },
        {
          "name": "Complete Training (Fail)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"score\": 55\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/training/assignments/{{assignmentId}}/complete", "host": ["{{baseUrl}}"], "path": ["api","v1","training","assignments","{{assignmentId}}","complete"] }
          },
          "response": []
        },
        {
          "name": "Complete Training (With Signature)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"score\": 88,\n  \"signature_id\": \"YOUR_SIGNATURE_UUID\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/training/assignments/{{assignmentId}}/complete", "host": ["{{baseUrl}}"], "path": ["api","v1","training","assignments","{{assignmentId}}","complete"] }
          },
          "response": []
        }
      ]
