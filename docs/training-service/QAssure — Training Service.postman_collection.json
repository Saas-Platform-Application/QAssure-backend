          "name": "Assign Training (with due_date)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"course_id\": \"{{courseId}}\",\n  \"user_id\": \"{{userId}}\",\n  \"reason\": \"recertification\",\n  \"due_date\": \"2026-09-30\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/training/assignments", "host": ["{{baseUrl}}"], "path": ["api","v1","training","assignments"] }
          },
          "response": []
