          },
          "response": []
        }
      ]
    },
    {
      "name": "My Training",
      "item": [
        {
          "name": "Get My Assignments",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/training/my/assignments", "host": ["{{baseUrl}}"], "path": ["api","v1","training","my","assignments"] }
          },
          "response": []
        },
        {
          "name": "Get My Assignments (Filter by Status)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/training/my/assignments?status=assigned&limit=20&offset=0",
              "host": ["{{baseUrl}}"], "path": ["api","v1","training","my","assignments"],
              "query": [{ "key": "status", "value": "assigned" }, { "key": "limit", "value": "20" }, { "key": "offset", "value": "0" }]
            }
          },
          "response": []
