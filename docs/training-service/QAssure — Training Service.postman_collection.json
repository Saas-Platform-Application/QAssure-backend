          "name": "Get Course — Not Found (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/training/courses/00000000-0000-0000-0000-000000000000", "host": ["{{baseUrl}}"], "path": ["api","v1","training","courses","00000000-0000-0000-0000-000000000000"] }
          },
          "response": []
        },
        {
          "name": "Start Assignment — Invalid Status (400)",
          "request": {
            "method": "POST",
            "header": [],
