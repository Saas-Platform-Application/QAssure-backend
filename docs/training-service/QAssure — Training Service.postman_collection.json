        {
          "name": "Create Competency (Custom Levels)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Statistical Process Control\",\n  \"category\": \"technical\",\n  \"levels\": [\n    { \"level\": 1, \"name\": \"Aware\", \"description\": \"Knows SPC exists\" },\n    { \"level\": 2, \"name\": \"User\", \"description\": \"Can read control charts\" },\n    { \"level\": 3, \"name\": \"Practitioner\", \"description\": \"Can set up control charts\" },\n    { \"level\": 4, \"name\": \"Expert\", \"description\": \"Can train others on SPC\" }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/training/competencies", "host": ["{{baseUrl}}"], "path": ["api","v1","training","competencies"] }
          },
          "response": []
