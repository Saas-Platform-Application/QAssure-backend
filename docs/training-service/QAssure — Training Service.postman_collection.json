    {
      "name": "Competencies",
      "item": [
        {
          "name": "Create Competency (Default Levels)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('competencyId', body.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"GMP Compliance\",\n  \"description\": \"Understanding and application of GMP requirements\",\n  \"category\": \"regulatory\",\n  \"role_requirements\": {\n    \"operator\": 2,\n    \"quality_manager\": 4\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/training/competencies", "host": ["{{baseUrl}}"], "path": ["api","v1","training","competencies"] }
          },
          "response": []
