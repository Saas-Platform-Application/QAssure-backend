      "item": [
        {
          "name": "Create Course — Missing Fields (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Only Title\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/training/courses", "host": ["{{baseUrl}}"], "path": ["api","v1","training","courses"] }
          },
          "response": []
