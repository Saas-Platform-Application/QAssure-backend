        {
          "name": "Create Competency — Duplicate Name (409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"GMP Compliance\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/training/competencies", "host": ["{{baseUrl}}"], "path": ["api","v1","training","competencies"] }
