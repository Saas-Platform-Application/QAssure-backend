        {
          "name": "Get Competency Matrix (All)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/training/competencies", "host": ["{{baseUrl}}"], "path": ["api","v1","training","competencies"] }
          },
          "response": []
        },
        {
          "name": "Get Competency Matrix (By User)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/training/competencies?user_id={{userId}}",
              "host": ["{{baseUrl}}"], "path": ["api","v1","training","competencies"],
              "query": [{ "key": "user_id", "value": "{{userId}}" }]
            }
          },
          "response": []
        },
        {
          "name": "Update User Competency",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current_level\": 2,\n  \"target_level\": 3,\n  \"evidence\": \"Demonstrated understanding during SOP review audit on 2026-06-29\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/training/competencies/{{userId}}/{{competencyId}}",
              "host": ["{{baseUrl}}"], "path": ["api","v1","training","competencies","{{userId}}","{{competencyId}}"]
            }
          },
          "response": []
