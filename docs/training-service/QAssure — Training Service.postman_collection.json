        {
          "name": "Get My Training Records",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/training/my/records", "host": ["{{baseUrl}}"], "path": ["api","v1","training","my","records"] }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Courses",
      "item": [
        {
          "name": "Create Course (Minimal)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('courseId', body.data.id);",
                  "  console.log('courseId set:', body.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"course_code\": \"QMS-001\",\n  \"title\": \"Quality Management Basics\",\n  \"course_type\": \"online\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/training/courses", "host": ["{{baseUrl}}"], "path": ["api","v1","training","courses"] }
          },
          "response": []
        },
        {
          "name": "Create Course (Full)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"course_code\": \"GMP-001\",\n  \"title\": \"GMP Fundamentals\",\n  \"description\": \"Comprehensive GMP training for all manufacturing staff.\",\n  \"course_type\": \"classroom\",\n  \"category\": \"compliance\",\n  \"duration_hours\": 8,\n  \"passing_score\": 75,\n  \"max_attempts\": 2,\n  \"prerequisites\": [],\n  \"required_for_roles\": [\"operator\", \"quality_technician\"],\n  \"required_for_departments\": [\"manufacturing\"],\n  \"requires_recertification\": true,\n  \"recertification_months\": 12,\n  \"content_url\": \"https://lms.example.com/gmp-001\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/training/courses", "host": ["{{baseUrl}}"], "path": ["api","v1","training","courses"] }
          },
          "response": []
        },
        {
          "name": "List Courses",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/training/courses", "host": ["{{baseUrl}}"], "path": ["api","v1","training","courses"] }
          },
          "response": []
        },
        {
          "name": "List Courses (With Filters)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/training/courses?status=active&category=compliance&course_type=online&search=GMP&limit=10&offset=0",
              "host": ["{{baseUrl}}"], "path": ["api","v1","training","courses"],
              "query": [
                { "key": "status", "value": "active" },
                { "key": "category", "value": "compliance" },
                { "key": "course_type", "value": "online" },
                { "key": "search", "value": "GMP" },
                { "key": "limit", "value": "10" },
                { "key": "offset", "value": "0" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Course by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/training/courses/{{courseId}}", "host": ["{{baseUrl}}"], "path": ["api","v1","training","courses","{{courseId}}"] }
          },
          "response": []
        },
        {
          "name": "Update Course",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Quality Management Basics v2\",\n  \"status\": \"active\",\n  \"passing_score\": 85,\n  \"description\": \"Updated course description.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/training/courses/{{courseId}}", "host": ["{{baseUrl}}"], "path": ["api","v1","training","courses","{{courseId}}"] }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Assignments",
      "item": [
        {
          "name": "Assign Training (with due_days)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('assignmentId', body.data.id);",
                  "  console.log('assignmentId set:', body.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"course_id\": \"{{courseId}}\",\n  \"user_id\": \"{{userId}}\",\n  \"reason\": \"new_hire\",\n  \"due_days\": 14\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/training/assignments", "host": ["{{baseUrl}}"], "path": ["api","v1","training","assignments"] }
          },
          "response": []
