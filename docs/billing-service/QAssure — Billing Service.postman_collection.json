						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"tenant_id\": \"c0000000-0000-0000-0000-000000000001\",\n    \"license_id\": \"{{license_id}}\",\n    \"due_date\": \"2026-07-26T00:00:00.000Z\",\n    \"subtotal\": 199.00,\n    \"tax_rate\": 10.00,\n    \"tax_amount\": 19.90,\n    \"total\": 218.90,\n    \"amount_due\": 218.90,\n    \"billing_name\": \"Pharma Corp Quality Procurement\",\n    \"billing_email\": \"billing@pharmacorp.com\",\n    \"items\": [\n        {\n            \"description\": \"AiCE Starter Tier - Monthly Subscription\",\n            \"quantity\": 1,\n            \"unit_price\": 199.00,\n            \"amount\": 199.00,\n            \"item_type\": \"license\"\n        }\n    ]\n}"
						},
						"url": {
							"raw": "{{base_url}}/billing/invoices",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"billing",
								"invoices"
							]
						},
						"description": "Generates a draft invoice header for a tenant's subscription license (Super Admin only)."
