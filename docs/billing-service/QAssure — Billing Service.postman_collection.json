{
	"info": {
		"_postman_id": "caca0f90-ef31-482d-88bb-cfda4091abce",
		"name": "QAssure — Billing Service",
		"description": "API collection for QAssure Billing Service.\n\nBase URL: http://localhost:3000/api/v1\n\nAuth: Bearer JWT Token\n\nFolders included:\n- Auth: Helper login endpoints to save the jwt_token\n- Pricing Plans: Retrieval and creation of subscription price tiers\n- Invoices: Full lifecycle from draft creation, send dispatch, voiding, and retrieval\n- Payments: Recording transactions and querying payment records\n- Summaries: Tenant dashboard summary and revenue aggregations for Super Admins",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "🔐 Auth",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.access_token) {",
									"    pm.collectionVariables.set('jwt_token', jsonData.data.access_token);",
									"    console.log('✅ Token saved');",
									"}",
									"pm.test('Login successful', function () {",
									"    pm.response.to.have.status(200);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@pharmacorp.com\",\n    \"password\": \"Admin@123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"login"
							]
						},
						"description": "Authenticate user credentials to retrieve JWT token and auto-populate the jwt_token variable."
					},
					"response": []
				}
			]
		},
