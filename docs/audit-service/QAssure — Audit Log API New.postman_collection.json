							"script": {
								"exec": [
									"const res = pm.response.json();",
									"pm.test('Status 403', () => pm.response.to.have.status(403));",
									"pm.test('Success false', () => pm.expect(res.success).to.be.false);",
									"pm.test('Error code is FORBIDDEN', () => pm.expect(res.error.code).to.equal('FORBIDDEN'));",
