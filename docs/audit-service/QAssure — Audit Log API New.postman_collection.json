								"exec": [
									"const res = pm.response.json();",
									"pm.test('Status 200', () => pm.response.to.have.status(200));",
									"pm.test('Success true', () => pm.expect(res.success).to.be.true);",
									"pm.test('Has data array', () => pm.expect(res.data).to.be.an('array'));",
									"pm.test('Has pagination', () => pm.expect(res.pagination).to.be.an('object'));",
									"pm.test('Has total count', () => pm.expect(res.pagination.total).to.be.a('number'));",
									"pm.test('Has totalPages', () => pm.expect(res.pagination.totalPages).to.be.a('number'));",
									"pm.test('Has hasMore', () => pm.expect(res.pagination.hasMore).to.be.a('boolean'));",
									"if (res.data.length > 0) {",
									"    const log = res.data[0];",
									"    pm.collectionVariables.set('audit_log_id', log.id);",
									"    console.log('Saved audit_log_id:', log.id);",
									"    pm.test('Log has id', () => pm.expect(log.id).to.be.a('string'));",
									"    pm.test('Log has action', () => pm.expect(log.action).to.be.a('string'));",
									"    pm.test('Log has resource_type', () => pm.expect(log.resource_type).to.be.a('string'));",
									"    pm.test('Log has created_at', () => pm.expect(log.created_at).to.be.a('string'));",
									"    pm.test('All logs belong to Pharma Corp tenant', () => {",
									"        res.data.forEach(l => {",
									"            if (l.tenant_id !== null) {",
									"                pm.expect(l.tenant_id).to.equal('c0000000-0000-0000-0000-000000000001');",
									"            }",
									"        });",
									"    });",
									"}"
								],
								"type": "text/javascript"
							}
						}
