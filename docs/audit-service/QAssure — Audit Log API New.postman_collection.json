				{
					"name": "Tenant Isolation — Tenant Admin Cannot See Other Tenant Logs",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const res = pm.response.json();",
									"pm.test('Status 200', () => pm.response.to.have.status(200));",
									"pm.test('Success true', () => pm.expect(res.success).to.be.true);",
									"if (res.data.length > 0) {",
									"    pm.test('No logs from BioTech tenant', () => {",
									"        const bioTechId = 'c0000000-0000-0000-0000-000000000002';",
									"        res.data.forEach(log => {",
									"            pm.expect(log.tenant_id).to.not.equal(bioTechId);",
									"        });",
									"    });",
									"}",
									"console.log('Tenant isolation confirmed — no BioTech logs visible to Pharma Corp admin');"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{tenant_admin_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/audit-logs?limit=100",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"audit-logs"
							],
							"query": [
								{
									"key": "limit",
									"value": "100"
								}
							]
						},
						"description": "Confirms tenant admin cannot see logs from other tenants (BioTech Inc). All returned logs must have tenant_id = Pharma Corp or null."
					},
					"response": []
				},
				{
					"name": "My Logs — Verify User Sees Only Own Logs",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const res = pm.response.json();",
									"pm.test('Status 200', () => pm.response.to.have.status(200));",
									"pm.test('Success true', () => pm.expect(res.success).to.be.true);",
									"if (res.data.length > 0) {",
									"    const decoded = JSON.parse(atob(pm.collectionVariables.get('regular_user_token').split('.')[1]));",
									"    pm.test('All logs belong to Bob', () => {",
									"        res.data.forEach(log => pm.expect(log.user_id).to.equal(decoded.sub));",
									"    });",
									"    console.log('Confirmed: Bob only sees his own logs, user_id:', decoded.sub);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{regular_user_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/audit-logs/my-logs",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"audit-logs",
								"my-logs"
							]
						},
						"description": "Verifies that Bob (regular user) only sees logs where user_id matches his own ID."
					},
					"response": []
				}
