		{
			"name": "🛡️ Super Admin CRUD",
			"item": [
				{
					"name": "Create License",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.id) {",
									"    pm.collectionVariables.set('license_id', jsonData.data.id);",
									"    pm.collectionVariables.set('license_key', jsonData.data.license_key);",
									"    console.log('✅ License ID and Key saved');",
									"}",
									"pm.test('Created successfully', function () {",
									"    pm.response.to.have.status(201);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"tenant_id\": \"c0000000-0000-0000-0000-000000000001\",\n    \"license_type\": \"subscription\",\n    \"tier\": \"professional\",\n    \"application\": \"aice\",\n    \"expires_at\": \"2027-06-26T12:00:00.000Z\",\n    \"limits\": {\n        \"max_users\": 25,\n        \"max_storage_gb\": 100\n    },\n    \"features\": [\"cer_generation\", \"literature_search\"],\n    \"notes\": \"Standard professional tier setup\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/licenses",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"licenses"
							]
						},
						"description": "Generate a new license key with tier constraints."
					},
					"response": []
				},
